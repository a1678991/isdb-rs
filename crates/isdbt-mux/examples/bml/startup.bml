<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bml PUBLIC "+//ARIB STD-B24:1999//DTD BML Document//JA" "http://www.arib.or.jp/B24/DTD/bml_1_1.dtd">
<?bml bml-version="3.0"?>
<bml>
<head>
<title>isdb-rs データ放送 メニュー</title>
<style>
<![CDATA[
body {
	resolution:960x540;
	display-aspect-ratio:16v9;
	used-key-list:basic data-button;
	background-color-index:4;
}
p {
	font-size:24px;
	line-height:32px;
	color-index:7;
	background-color-index:4;
}
#fcs {
	left:0px;
	top:0px;
	width:960px;
	height:540px;
	nav-index:0;
}
.title {
	left:20px;
	top:16px;
	width:440px;
	height:40px;
	font-size:30px;
	line-height:40px;
	color-index:3;
}
.menu {
	left:40px;
	width:400px;
	height:36px;
	font-size:24px;
	line-height:36px;
	color-index:7;
	background-color-index:0;
}
.strip {
	left:0px;
	top:270px;
	width:960px;
	height:270px;
	background-color-index:0;
}
.news {
	left:20px;
	width:920px;
	height:32px;
	font-size:24px;
	line-height:32px;
	color-index:7;
	background-color-index:0;
}
.key {
	top:490px;
	width:200px;
	height:36px;
	font-size:20px;
	line-height:36px;
	color-index:7;
	text-align:center;
}
]]>
</style>
<script>
<![CDATA[
var cur = 0;
var pages = new Array("info", "news", "weather", "about");
function G(id) { return document.getElementById(id); }
function paint() {
	var i;
	for (i = 0; i < 4; i++) {
		var m = G("m" + i);
		if (i == cur) {
			m.normalStyle.backgroundColorIndex = 3;
			m.normalStyle.colorIndex = 0;
		} else {
			m.normalStyle.backgroundColorIndex = 0;
			m.normalStyle.colorIndex = 7;
		}
	}
	G("hint").firstChild.data = "上下で選択、決定で開く（選択中: " + G("m" + cur).firstChild.data + "）";
}
function open(n) {
	browser.Ureg[1] = String(n);
	browser.launchDocument("/40/0000/info.bml", "cut");
}
function moduleUpdated() {
	if (document.currentEvent.status == 0) {
		browser.reloadActiveDocument();
	}
}
function init() {
	paint();
	G("fcs").focus();
}
function keydown() {
	var c = parseInt(document.currentEvent.keyCode, 10);
	if (c == 1) {
		cur = (cur + 3) % 4;
		paint();
	} else if (c == 2) {
		cur = (cur + 1) % 4;
		paint();
	} else if (c == 18) {
		open(cur);
	} else if (c == 21) {
		open(0);
	} else if (c == 22) {
		open(1);
	} else if (c == 23) {
		open(2);
	} else if (c == 24) {
		var s = G("strip");
		if (s.normalStyle.visibility == "hidden") {
			s.normalStyle.visibility = "visible";
		} else {
			s.normalStyle.visibility = "hidden";
		}
	}
}
]]>
</script>
<bevent>
	<beitem id="MUP" type="ModuleUpdated" module_ref="/40/0000" subscribe="subscribe" onoccur="moduleUpdated();"/>
</bevent>
</head>
<body id="body" onload="init();">
	<div id="stream" style="left:480px; top:0px; width:480px; height:270px">
		<object id="Vstream" type="video/X-arib-mpeg2" data="/-1" remain="remain" style="left:0px; top:0px; width:480px; height:270px;"/>
		<object id="Astream" type="audio/X-arib-mpeg2-aac" data="/-1" remain="remain" streamstatus="play"/>
	</div>
	<div id="fcs" onkeydown="keydown();"></div>
	<p class="title">isdb-rs データ放送テスト</p>
	<p id="m0" class="menu" style="top:80px;">番組情報</p>
	<p id="m1" class="menu" style="top:124px;">ニュース</p>
	<p id="m2" class="menu" style="top:168px;">天気予報</p>
	<p id="m3" class="menu" style="top:212px;">このページについて</p>
	<div id="strip" class="strip">
		<p class="news" style="top:290px;">このページは isdbt-mux の bml-carousel が送出しています。</p>
		<p class="news" style="top:330px;">右上の映像は放送中の番組（video/X-arib-mpeg2、480x270）です。</p>
		<p id="hint" class="news" style="top:370px;">上下で選択、決定で開く</p>
		<p class="news" style="top:410px;">黄: 下の帯を隠す／戻す　　d: データ放送を終了</p>
		<p class="key" style="left:20px; background-color-index:4;">青　番組情報</p>
		<p class="key" style="left:260px; background-color-index:1;">赤　ニュース</p>
		<p class="key" style="left:500px; background-color-index:2;">緑　天気予報</p>
		<p class="key" style="left:740px; background-color-index:3; color-index:0;">黄　帯の表示</p>
	</div>
</body>
</bml>
