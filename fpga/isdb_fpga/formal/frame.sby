# FrameCtl's frame boundaries (frame.py): `python tools/formal.py frame`.
# bmc: every path of DEPTH cycles from reset; cover: each Cover reached;
# prove: k-induction, unbounded (o_done is out of a bounded run's reach).
[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 30
cover: mode cover
cover: depth 30
prove: mode prove
prove: depth 4

[engines]
smtbmc boolector

[script]
read_rtlil frame.il
prep -top top

[files]
frame.il
